# 이 파일을 .env 로 복사해 키를 입력한 뒤 `npm run env` 를 실행하세요.
# .env 와 생성된 assets/js/keys.js 는 커밋되지 않습니다.

# 공공데이터포털 일반 인증키 (한국관광공사_국문 관광정보 서비스_GW, 한국환경공단_전기자동차 충전소 정보)
DATA_GO_KR_API_KEY=

# 카카오 디벨로퍼스 JavaScript 키 (앱 설정 > 플랫폼 > Web 에 실행 주소 등록, 예: http://localhost:5500)
KAKAO_MAP_KEY=

# (선택) 카카오 REST API 키 — 여행 계획의 실제 도로 경로·소요 시간 (카카오모빌리티 길찾기)
# 없으면 직선거리로 계산합니다. 같은 카카오 앱의 [앱 키 > REST API 키]
KAKAO_REST_KEY=

# (선택) 충전소 API 를 다른 공공데이터포털 계정으로 승인받았다면 그 계정의 일반 인증키
# 비워 두면 DATA_GO_KR_API_KEY 를 사용합니다.
EV_API_KEY=
