<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 버전 관리(JUnit, Jackson 등)는 Spring Boot 가 맞춰 준 조합을 모든 모듈이 함께 쓴다 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.ssafy.enjoytrip</groupId>
    <artifactId>enjoytrip-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>EnjoyTrip EV</name>
    <description>관통 프로젝트 — 알고리즘 모듈 + Spring Boot 백엔드</description>

    <modules>
        <module>algorithm-core</module>
        <module>algorithm-bench</module>
        <module>backend</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Windows 콘솔에서 테스트 출력의 한글이 깨지지 않도록 -->
        <argLine>-Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8</argLine>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.ssafy.enjoytrip</groupId>
                <artifactId>algorithm-core</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
